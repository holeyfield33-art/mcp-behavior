{
  "schema_version": "mcp-behavior-config/v1",
  "command": ["${python}", "${config_dir}/reference_server.py"],
  "identity": {
    "name": "reference-inventory",
    "version": "0.1.0",
    "artifacts": ["${config_dir}/reference_server.py"]
  },
  "limits": {"timeout_seconds": 5},
  "profile": {
    "id": "readonly-repository",
    "version": "1.0.0",
    "tool": "inspect_repository",
    "path_argument": "path",
    "supported_suffixes": [".py", ".js", ".txt"],
    "relative_paths": "reject",
    "ignored_timestamps": ["/generated_at"],
    "observations": {
      "processed": {"pointer": "/processed", "path": "/path", "sha256": "/sha256"},
      "excluded": {"pointer": "/excluded", "path": "/path", "reason": "/reason"},
      "failed": {"pointer": "/failed", "path": "/path", "reason": "/reason"},
      "complete": "/complete",
      "counts": {"processed": "/counts/processed", "excluded": "/counts/excluded", "failed": "/counts/failed"}
    }
  }
}
