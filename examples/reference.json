{
  "identity": {
    "label": "reference-inventory",
    "version": "0.1.0"
  },
  "server": {
    "argv": ["${python}", "${config_dir}/reference_server.py"],
    "cwd": null
  },
  "tool": {
    "name": "inventory_files",
    "path_arg": "root",
    "extra_args": {}
  },
  "profile": {
    "name": "read-only-repo-inventory",
    "version": "1.0.0",
    "supported_suffixes": [".py", ".js", ".txt"],
    "relative_path_policy": "reject",
    "wire_byte_budget": 65536,
    "timestamp_paths": []
  },
  "mappings": {
    "processed": "/processed",
    "excluded": "/excluded",
    "failed": "/failed",
    "path_field": "path",
    "reason_field": "reason",
    "hash_field": "sha256",
    "complete_field": "/complete"
  }
}
